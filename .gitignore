# .gitignore

# Ignore node_modules in root (if any)
node_modules/

# Ignore node_modules in server
server/node_modules/

# Ignore node_modules in client
client/node_modules/

# Optional: Ignore environment files
server/.env
client/.env

# Optional: OS or editor files
.DS_Store
*.log

# Optional: Next.js build output
.next/
out/
build/

# Optional: npm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Optional: VSCode
.vscode/
config.bat
